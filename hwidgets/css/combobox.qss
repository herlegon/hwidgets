/* top, right, bottom, left */
QFrame {
    background-color: $window_bgd;
    background: $window_bgd;

    color: $font_color;
    font-family: $font_family;
    font-size: $font_size;
}

QComboBox {
    background-color: $widget_bgd;

    color: $font_color;
    font-family: $font_family;
    font-size: $font_size;

    selection-background-color: $selection_bgd;
    selection-color: $font_color;

    border-radius: $radius;
    padding-left: $padding_left;
    /* padding-right: $padding_right; */
}


QComboBox:disabled {
    background-color: $disabled_bgd;
    color: $font_color_disabled;
}


QComboBox:read-only:hover {
    background-color: $hover_bgd;
}


QComboBox:on {
    background-color: $hover_bgd;
    border-bottom-right-radius: 0px;
    border-bottom-left-radius: 0px;
}

QComboBox::drop-down {
    width: 32px;
    border: none;
}


QComboBox::down-arrow {
    width: 32px;
    height: 0px;
}

QComboBox QLineEdit{
    margin-bottom: 2px;
    color: green;

}


QComboBox QLineEdit[editing="true"] {
    border: 2px solid red; /* editing color */
}
