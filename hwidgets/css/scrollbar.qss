QScrollBar:vertical {
    background-color: $widget_bgd;
    /* background-color: transparent; */
    /* margin-top: $widget_margin;
    margin-bottom: $widget_margin; */
    /* margin-right: 1px; */
    margin: 0px;
    padding: 0px;
    border-radius: 0px;
    /* $track_radius; */
    width: $track_width;
    border: none;
    /* margin-top: 12px; */

}


QScrollBar:handle:vertical {
    background-color: $handle_bgd;
    border-radius: $handle_radius;
    width: $handle_width;
    border: 0px;
}


QScrollBar:handle:vertical:hover {
    background-color: $handle_bgd_hover;
    width: $handle_width;
    border: 0px;
    min-width: 25px;
}


QScrollBar::add-line:vertical {
    height: 0px;
}

QScrollBar:sub-line:vertical {
    height: 0px;
}

QScrollBar:add-page:vertical,
QScrollBar:sub-page:vertical {
    height: 0px;
    background: none;
}
