/* top, right, bottom, left */

QPlainTextEdit {
    background-color: $widget_bgd;

    color: $font_color;
    font-family: $font_family;
    font-size: $font_size;

    border: 1px solid $border_color;
    border-radius: $radius;

    selection-background-color: $selected_text;

    padding-left: $radius;
    padding-bottom: 2px;
    padding-top: 0px;
    padding-right: $radius;

}


QPlainTextEdit:read-only,
QPlainTextEdit:read-only:focus,
QPlainTextEdit:read-only:hover {
    background-color: $widget_bgd;
    border: none;
}


QPlainTextEdit:focus {
    color: $font_color;
    border: 1px solid $selected;

}

QPlainTextEdit:hover {
    background-color: $hover_bgd;
}


QPlainTextEdit:disabled {
    background-color: $disabled_bgd;
    color: $font_color_disabled;
}

