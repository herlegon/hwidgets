QSpinBox,
QDoubleSpinBox {
    background-color: $widget_bgd;

    min-width: 40px;
    border: 1px solid $widget_bgd;
    border-radius: $radius;
    margin: 0px;
    /* margin-right: $margin_right; */
    padding: 0px $padding_right 2px 0px;

    selection-background-color: $selection;
    /* selection-background-color: transparent; */
    /* selection-color: $font_color; */

    color: $font_color;
    font-family: $font_family;
    font-size: $font_size;
}


/* QSpinBox:read-only,
QDoubleSpinBox:read-only {
    background-color: $widget_bgd;
    border: 1px solid $widget_bgd;
} */



QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: $disabled;
    color: $font_color_disabled;
    border: 1px solid $disabled;
}


HSpinBox[hover="true"],
HDoubleSpinBox[hover="true"] {
    /* background-color: $hover; */
    border: 1px solid $hover;
}


QSpinBox:focus,
QDoubleSpinBox:focus{
    border: 1px solid $selection;
}

/* QSpinBox:read-only:focus,
QDoubleSpinBox:read-only:focus,
QSpinBox:read-only:hover,
QDoubleSpinBox:read-only:hover,
QSpinBox:read-only[hover="true"],
QDoubleSpinBox:read-only[hover="true"] {
    background-color: $widget_bgd;
    border: none;
} */
