QSpinBox,
QDoubleSpinBox {
    background-color: $widget_bgd;

    min-width: 40px;
    border: 1px solid $border_color;
    border-radius: $radius;
    margin: 0px;
    /* margin-right: $margin_right; */
    padding: 0px $padding_right 2px 0px;

    selection-background-color: $selection;
    /* selection-background-color: transparent; */
    /* selection-color: $font_color; */

    color: $font_color;
    font-family: $font_family;
    font-size: $font_size;
}


QSpinBox:focus,
QDoubleSpinBox:focus{
    border: 1px solid $border_edition;
}


QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: $disabled;
    color: $font_color_disabled;
}


HSpinBox[editing="true"],
HDoubleSpinBox[editing="true"] {
    border: 1px solid $border_edition;
}

HSpinBox[editing="false"],
HDoubleSpinBox[editing="false"] {
    border: 1px solid $border_color;
}


/* Moved to bottom to ensure precedence */
QSpinBox:read-only,
QDoubleSpinBox:read-only,
QSpinBox:read-only:focus,
QDoubleSpinBox:read-only:focus,
QSpinBox:read-only:hover,
QDoubleSpinBox:read-only:hover,
HSpinBox:read-only,
HDoubleSpinBox:read-only {
    background-color: $widget_bgd;
    border: 1px solid $border_color;
}
