QPushButton {
    background-color: $widget_bgd;
    border: none;
    border-radius: $radius;
    padding-left: 8px;
    padding-right: 8px;

    color: $text_color;
    font-family: "Segoe UI", "Sans Serif";
    font-size: 10pt;
}


QPushButton:disabled {
    background-color: $disabled_bgd;
    color: $widget_bgd
}

QPushButton:disabled:checked {
    background-color: $widget_hover;
    color: $widget_bgd
}


QPushButton:hover {
    background-color: $widget_hover;
    color: $text_color;
}


QPushButton:pressed {
    background-color: $widget_hover;
    color: $checked_color
}

QPushButton:checked {
    background-color: $widget_hover;
    color: $checked_text
}
