QPushButton {
    background-color: $widget_bgd;
    border: none;
    border-radius: $radius;
    padding-left: 8px;
    padding-right: 8px;
    padding-bottom: 0px;

    color: $font_color;
    font-family: $font_family;
    font-size: $font_size;
}


QPushButton:hover {
    background-color: $widget_hover;
    color: $font_color;
}


QPushButton:pressed {
    background-color: $selection_bgd;
    color: $font_color;
}


QPushButton:checked {
    background-color: $selection_bgd;
    color: $font_color;
}


QPushButton:disabled {
    background-color: $disabled_bgd;
    color: $text_disabled
}


QPushButton:disabled:checked {
    background-color: $widget_hover;
    color: $text_disabled
}

