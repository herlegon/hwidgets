/* top, right, bottom, left */

QLineEdit {
    background-color: $widget_bgd;

    color: $font_color;
    font-family: $font_family;
    font-size: $font_size;

    border: 1px solid $border_color;
    border-radius: $radius;

    selection-background-color: $selected_text;

    padding: 0px $padding_right 2px $padding_left;

}


QLineEdit:read-only,
QLineEdit:read-only:focus,
QLineEdit:read-only:hover {
    background-color: $widget_bgd;
    border: 1px solid $border_color;
}


QLineEdit:focus {
    color: $font_color;
    border: 1px solid $selected;

}

QLineEdit:hover {
    background-color: $hover_bgd;
}


QLineEdit:disabled {
    background-color: $disabled_bgd;
    color: $font_color_disabled;
}

